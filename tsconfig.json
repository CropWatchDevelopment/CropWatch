{
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"sourceMap": true,
		"strict": true
	},
	"include": ["src", "vite.config.ts"],
	// The service worker runs in a worker, not a page: src/service-worker has its
	// own tsconfig (WebWorker libs), checked by `pnpm check`.
	"exclude": ["src/service-worker"]
}
