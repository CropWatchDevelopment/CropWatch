patch: {}
# Snyk Code skips test code: the e2e harness talks to a local mock server with
# a fake login and fake reCAPTCHA keys (capture-pwa-screenshots.mjs signs in
# with the same fake login), and the specs use placeholder secrets.
# Application code under src/ (outside *.spec.ts) is still scanned.
exclude:
  global:
    - scripts/e2e-stack.mjs
    - e2e/**
    - '**/*.spec.ts'
    - scripts/capture-pwa-screenshots.mjs
