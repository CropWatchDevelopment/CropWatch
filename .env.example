# Copy to .env and fill in real values: cp .env.example .env
#
# Every key below must EXIST for `pnpm check` and `pnpm build` to pass, even if the
# value is a placeholder. SvelteKit generates the `$env/static/*` module types from
# the variables it can see at `svelte-kit sync` time — a missing key here surfaces as
# "Module '$env/static/public' has no exported member 'X'" rather than as a runtime
# error. CI copies this file verbatim; real values are only needed to actually run.
#
# Environments (development / staging / production) are separate sets of these
# values: keep one file per environment (.env.development, .env.staging,
# .env.production — all gitignored) and pick it with the Vite mode, e.g.
# `pnpm dev:staging`. See README › Environments.

# --- Environment ---
# development | staging | production. When unset the Vite mode decides
# (`vite dev` → development, `vite build` → production, `--mode staging` → staging).
PUBLIC_APP_ENV=development

# --- Supabase ($env/static/public) ---
# Needed to run: the server verifies every session token with this project's Supabase
# Auth (and ends the session on sign-out). Use the same project the CropWatch API uses.
PUBLIC_SUPABASE_URL=https://example.supabase.co
PUBLIC_SUPABASE_ANON_KEY=replace-me

# --- reCAPTCHA Enterprise ---
PUBLIC_RECAPTCHA_SITE_KEY=replace-me
PRIVATE_RECAPTCHA_SITE_KEY=replace-me
PRIVATE_RECAPTCHA_PROJECT_ID=replace-me
PRIVATE_RECAPTCHA_API_KEY=replace-me
# Optional: PRIVATE_RECAPTCHA_API_BASE_URL (default https://recaptchaenterprise.googleapis.com)
# Optional: PRIVATE_RECAPTCHA_LOG_LEVEL=silent|error|info|debug (default: error in production, else info)

# --- CropWatch API ---
PUBLIC_API_BASE_URL=https://api.example.com
# Optional path overrides; each defaults to the path shown.
PUBLIC_LOGIN_ENDPOINT=/auth/login
PUBLIC_DEVICE_STATUS_ENDPOINT=/devices/status
PUBLIC_AIR_NOTES_ENDPOINT=/air/notes
# Optional: PUBLIC_GET_AIR_NOTES_ENDPOINT (default /air/notes/{dev_eui}/month/{month}/year/{year})
# Optional: PUBLIC_RULE_TEMPLATES_ENDPOINT (default /rules)
# Optional: PUBLIC_REPORT_TEMPLATES_ENDPOINT (default /reports)

# --- Organizations ---
# Company sign-up is offered only when this is exactly `true`.
ORGS_ENABLED=false

# --- Libellus ---
PRIVATE_LIBELLUS_BASE_URL=https://example.libellus.com
PRIVATE_LIBELLUS_API_TOKEN=replace-me

# --- Analytics ---
PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# --- Firebase Cloud Messaging (web push; $env/static/public) ---
PUBLIC_FIREBASE_API_KEY=replace-me
PUBLIC_FIREBASE_AUTH_DOMAIN=example.firebaseapp.com
PUBLIC_FIREBASE_PROJECT_ID=replace-me
PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
PUBLIC_FIREBASE_APP_ID=1:000000000000:web:replace-me
PUBLIC_FIREBASE_VAPID_KEY=replace-me
