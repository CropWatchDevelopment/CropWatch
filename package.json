{
	"name": "cropwatch",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"engines": {
		"node": "24.x"
	},
	"scripts": {
		"dev": "vite dev",
		"dev:staging": "vite dev --mode staging",
		"build": "vite build",
		"build:staging": "vite build --mode staging",
		"preview": "vite preview",
		"prepare": "node ./scripts/generate-paraglide.mjs && svelte-kit sync || echo ''",
		"paraglide": "node ./scripts/generate-paraglide.mjs",
		"check": "node ./scripts/generate-paraglide.mjs && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "node ./scripts/generate-paraglide.mjs && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"style:audit": "node ./scripts/style-audit.mjs",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test:coverage": "vitest --run --coverage",
		"test": "npm run test:unit -- --run && npm run test:e2e",
		"test:e2e": "playwright test"
	},
	"devDependencies": {
		"@eslint/compat": "^2.1.0",
		"@eslint/js": "^9.39.4",
		"@inlang/paraglide-js": "^2.19.0",
		"@playwright/test": "^1.61.0",
		"@sveltejs/adapter-vercel": "^6.3.4",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@tailwindcss/vite": "^4.3.1",
		"@types/node": "^22.19.21",
		"@vitest/browser-playwright": "^4.1.11",
		"@vitest/coverage-v8": "4.1.11",
		"eslint": "^9.39.4",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.1",
		"globals": "^17.6.0",
		"playwright": "^1.61.0",
		"prettier": "^3.8.4",
		"prettier-plugin-svelte": "^3.5.2",
		"prettier-plugin-tailwindcss": "^0.7.4",
		"supabase": "^2.107.0",
		"svelte": "^5.56.3",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.1",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.61.1",
		"vite": "^7.3.5",
		"vite-plugin-devtools-json": "^1.0.0",
		"vitest": "^4.1.11"
	},
	"packageManager": "pnpm@10.18.2+sha512.9fb969fa749b3ade6035e0f109f0b8a60b5d08a1a87fdf72e337da90dcc93336e2280ca4e44f2358a649b83c17959e9993e777c2080879f3801e6f0d999ad3dd",
	"pnpm": {
		"overrides": {
			"esbuild@<0.28.1": ">=0.28.1",
			"cookie@<0.7.0": "^0.7.0",
			"@grpc/grpc-js@<1.14.5": "1.14.5",
			"uri-js": "npm:fast-uri@^3.1.8"
		}
	},
	"dependencies": {
		"@cropwatchdevelopment/cwui": "0.1.115",
		"@cropwatchdevelopment/qr-scanner": "0.1.0",
		"@supabase/supabase-js": "^2.108.2",
		"firebase": "^12.19.0",
		"maplibre-gl": "6.11.2"
	}
}
